+
+    internal static async Task<ValidationReport> ExecuteOwnedAsync(string scenario, ValidationRunState state, Func<ValidationRunState, Task> execute)
+    {
+        // Existing behavior exposed at its actual resource owner before changing failure precedence.
+        try
+        {
+            await using (state)
+            {
+                await execute(state);
+                return ValidationReport.Pass(scenario, state.RunId);
+            }
+        }
+        catch (ValidationProbeException failure) { return ValidationReport.Fail(scenario, failure.Code); }
+        catch (SessionOperationException failure) { return ValidationReport.Fail(scenario, failure.Failure.Code.ToString()); }
+        catch (Exception) { return ValidationReport.Fail(scenario, "ScenarioExecutionFailed"); }
+    }
 }
