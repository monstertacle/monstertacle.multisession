<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <Format>json,cobertura</Format>
          <Include>[Monstertacle.Multisession.AgentFramework]*,[Monstertacle.Multisession.Common]*,[Monstertacle.Multisession.Storage.Sqlite]*,[Monstertacle.Multisession.Windows]*,[Monstertacle.Multisession.Linux]*,[Monstertacle.Multisession.Providers.Conversations]*,[Monstertacle.Multisession.Providers.Interactions]*,[Monstertacle.Multisession.Delivery]*,[Monstertacle.Multisession.ValidationHost]*</Include>
          <IncludeTestAssembly>false</IncludeTestAssembly>
          <SkipAutoProps>false</SkipAutoProps>
          <ExcludeAssembliesWithoutSources>None</ExcludeAssembliesWithoutSources>
          <ExcludeByFile>**/obj/**</ExcludeByFile>
          <UseSourceLink>false</UseSourceLink>
          <SingleHit>false</SingleHit>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
